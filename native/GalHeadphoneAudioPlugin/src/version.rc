#include <windows.h>

// Version resource of the native DSP. The file version follows the plugin ABI
// (GAL_HeadphonesAbiVersion), not the mod release: the DLL changes only when the
// DSP changes, and its SHA-256 is pinned by the preloader and the packaging script.
VS_VERSION_INFO VERSIONINFO
FILEVERSION 3,0,0,0
PRODUCTVERSION 3,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Anamelash"
      VALUE "FileDescription", "Guns Are Loud headset electronics DSP (Unity native audio effect)"
      VALUE "FileVersion", "3.0.0.0"
      VALUE "InternalName", "AudioPluginGalHeadphones"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "AudioPluginGalHeadphones.dll"
      VALUE "ProductName", "Guns Are Loud"
      VALUE "ProductVersion", "ABI 3"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
